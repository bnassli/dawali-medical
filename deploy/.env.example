# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Name the clinic PCs use to open the system (must resolve to this server on the clinic
# network: router DNS entry or each PC's hosts file), e.g. dawali.clinic.local
SITE_ADDRESS=dawali.clinic.local

# Long random password for the database (letters and digits only).
POSTGRES_PASSWORD=change-me-to-a-long-random-password

APP_TIME_ZONE=Asia/Riyadh
SESSION_TTL_HOURS=12

# First administrator, created on first start only (then change the password in the app).
SEED_ADMIN_EMAIL=admin@dawali.clinic
SEED_ADMIN_PASSWORD=change-me-too

# Optional: AI reading of scanned purchase invoices (Anthropic API key).
ANTHROPIC_API_KEY=
INVOICE_AI_MODEL=claude-sonnet-5
