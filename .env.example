# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# PostgreSQL connection string used by the app, migrator, and seed script.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dawali_medical

# development | test | production
NODE_ENV=development

# Session lifetime in hours (optional, defaults to 12).
SESSION_TTL_HOURS=12

# Canonical public origin of the app: scheme + host (+ port), no path.
# The clinical autosave API only accepts requests whose Origin matches this
# EXACTLY (scheme, host and port). REQUIRED in production (the API fails closed
# without it); behind a TLS-terminating proxy set the PUBLIC https URL, not the
# internal one. X-Forwarded-Host / X-Forwarded-Proto are never trusted. In
# development and test it may be omitted (the request's own origin is used).
APP_ORIGIN=http://localhost:3000

# IANA time zone of the clinic, used for calendar dates such as a patient's
# age "today". Optional; defaults to Asia/Riyadh.
APP_TIME_ZONE=Asia/Riyadh

# Required only when running `npm run db:seed`: creates the initial admin user
# if it does not exist yet. An existing account is never modified (password,
# active state and roles are left unchanged). No default password in code.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
